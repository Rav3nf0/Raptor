# RAPTOR demo — credential-free config. Source this before launching uvicorn.
# Everything runs offline against synthetic data; no external APIs are called.

# Demo mode: skip the ticketing poller / closure poller (they only add log noise
# with no credentials). Drive triage via POST /api/edr-triage/run-synthetic.
DEMO_MODE=true

# Deterministic playbook path — no LLM inference, no Mantle/AWS/Ollama calls.
LLM_BACKEND=rule_based
USE_AGENT_LOOP=false

# Never write to any ticketing system.
EDR_DRY_RUN=true

# Keep the background SCG jobs quiet for a short demo.
SCG_DECAY_ENABLED=false
SCG_DRIFT_ENABLED=false

# Login (required — an unset password 500s the login page and blocks the JWT secret).
DEEPINTEL_USERNAME=admin
DEEPINTEL_PASSWORD=demo

# Local MongoDB (docker compose up -d).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepintel

# All external credentials intentionally blank.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
MDE_TENANT_ID=
MDE_CLIENT_ID=
MDE_CLIENT_SECRET=
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
