# RAPTOR — environment config. Copy to .env and fill in for a live deployment.
# For the credential-free demo you do NOT need this file — see demo/demo.env.

ENV=local

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=deepintel

# Login (required). Password also derives the JWT session secret.
DEEPINTEL_USERNAME=admin
DEEPINTEL_PASSWORD=

# ── LLM backend ─────────────────────────────────────────────────────────────
# Agent loop (primary triage path): mantle | bedrock | ollama | gemini
AGENT_BACKEND=ollama
# Legacy generic-playbook path: ollama | gemini | rule_based
LLM_BACKEND=rule_based
# Self-hosted LLM (Ollama) — point at your inference host.
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=deepseek-r1:8b
# Run the ReAct agent loop (true) or the deterministic playbook only (false).
USE_AGENT_LOOP=false

# ── Ticketing (Jira) — leave blank to disable the poller ────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
EDR_JIRA_PROJECT=SEC
EDR_DRY_RUN=true

# ── Microsoft Defender for Endpoint (optional enrichment) ───────────────────
MDE_TENANT_ID=
MDE_CLIENT_ID=
MDE_CLIENT_SECRET=

# ── Microsoft Sentinel workspace (optional hunts) ───────────────────────────
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=

# ── VirusTotal (optional hash reputation) ───────────────────────────────────
VIRUSTOTAL_API_KEY=

# ── Data-boundary sanitizer (for external LLM backends) ─────────────────────
# Comma-separated internal email domains to redact before any external LLM call.
SANITIZER_INTERNAL_DOMAINS=example.com,corp.example.com
# Your org's brand token to scrub from displayed telemetry (optional).
SANITIZER_COMPANY_NAME=

# ── Background jobs ─────────────────────────────────────────────────────────
SCG_DECAY_ENABLED=true
SCG_DRIFT_ENABLED=true
